{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edlb.example/schemas/v1/checkpoint.json",
  "title": "Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "world_id",
    "sequence",
    "available_at",
    "window_start",
    "window_end",
    "status",
    "objective_ids",
    "visible_artifact_ids",
    "required_roles",
    "max_tool_calls",
    "max_turns",
    "terminal"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "complete", "failed"]
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "visible_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "released_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "account_executive",
          "domain_specialist",
          "sales_manager",
          "revops"
        ]
      }
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "terminal": {
      "type": "boolean"
    }
  }
}
