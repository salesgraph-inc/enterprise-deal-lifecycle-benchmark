{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edlb.example/schemas/v1/event.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "role_scoped"
          }
        },
        "required": ["visibility"]
      },
      "then": {
        "required": ["visible_roles"],
        "properties": {
          "visible_roles": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "required": [
    "event_id",
    "world_id",
    "sequence",
    "kind",
    "effective_at",
    "recorded_at",
    "available_at",
    "actor_ids",
    "visibility",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "meeting_booked",
        "meeting_held",
        "message_sent",
        "stakeholder_joined",
        "stakeholder_departed",
        "requirement_changed",
        "budget_changed",
        "approval_requested",
        "approval_decided",
        "document_created",
        "document_revised",
        "crm_projection_changed",
        "external_signal_published",
        "workflow_gate_completed",
        "terminal_outcome"
      ]
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "visibility": {
      "type": "string",
      "enum": ["oracle_only", "agent_visible", "role_scoped"]
    },
    "visible_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "account_executive",
          "domain_specialist",
          "sales_manager",
          "revops"
        ]
      }
    },
    "channel": {
      "type": ["string", "null"],
      "enum": [
        null,
        "system",
        "call_transcript",
        "email",
        "internal_chat",
        "crm",
        "calendar",
        "document",
        "web_signal"
      ]
    },
    "causal_parent_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    }
  }
}
