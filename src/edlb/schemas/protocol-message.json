{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edlb.example/schemas/v1/protocol-message.json",
  "title": "EDLB JSONL Protocol Message",
  "oneOf": [
    {"$ref": "#/$defs/start"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/tool_call"},
    {"$ref": "#/$defs/tool_result"},
    {"$ref": "#/$defs/team_message"},
    {"$ref": "#/$defs/yield"},
    {"$ref": "#/$defs/checkpoint_complete"},
    {"$ref": "#/$defs/run_end"}
  ],
  "$defs": {
    "observation_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "model_metadata": {
      "type": "object",
      "minProperties": 1
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "payload"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "start"},
        "role": {"const": "system"},
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "payload": {"type": "object", "minProperties": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "payload"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "observation"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "payload": {"type": "object", "minProperties": 1}
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "observation_token",
        "tool_name",
        "arguments"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "tool_call"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "tool_name": {
          "type": "string",
          "pattern": "^(crm|communications|calendar|documents|approvals|web|team|run)\\.[a-z0-9_]+$"
        },
        "arguments": {"type": "object"},
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool_name": {
                "pattern": "^(crm|communications|calendar|documents|approvals|team|run)\\.(send|update|merge|schedule|reschedule|cancel|create|revise|attach|request|approve|reject|complete_checkpoint)$"
              }
            }
          },
          "then": {"required": ["idempotency_key"]}
        }
      ]
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "call_id",
        "ok"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "tool_result"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "call_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "ok": {"type": "boolean"},
        "result": {"type": "object"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "message": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [
        {"required": ["result"], "properties": {"ok": {"const": true}}},
        {"required": ["error"], "properties": {"ok": {"const": false}}}
      ]
    },
    "team_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "observation_token",
        "recipient_role",
        "payload"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "team_message"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "recipient_role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "payload": {"type": "object", "minProperties": 1}
      }
    },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "observation_token"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "yield"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "reason": {"type": "string"}
      }
    },
    "checkpoint_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "observation_token",
        "checkpoint_id",
        "summary"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "checkpoint_complete"},
        "role": {
          "type": "string",
          "enum": ["account_executive", "domain_specialist", "sales_manager", "revops"]
        },
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "checkpoint_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "run_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "sequence",
        "message_id",
        "occurred_at",
        "kind",
        "role",
        "observation_token",
        "status"
      ],
      "properties": {
        "protocol_version": {"type": "string", "const": "v1.0.0"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "message_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"const": "run_end"},
        "role": {"const": "system"},
        "observation_token": {"$ref": "#/$defs/observation_token"},
        "model_metadata": {"$ref": "#/$defs/model_metadata"},
        "status": {"type": "string", "enum": ["completed", "failed", "invalid"]},
        "reason": {"type": "string"}
      }
    }
  }
}
