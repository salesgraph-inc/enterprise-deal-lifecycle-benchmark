{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edlb.example/schemas/v1/run-manifest.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "benchmark_version",
    "world_id",
    "track",
    "team_id",
    "protocol_version",
    "tool_schema_version",
    "scenario_hash",
    "rubric_hash",
    "oracle_hash",
    "seed",
    "agent_manifest",
    "stakeholder_manifest",
    "limits",
    "environment",
    "started_at",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "benchmark_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "track": {
      "type": "string",
      "enum": ["fixed_harness", "open_team"]
    },
    "team_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tool_schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracle_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "agent_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved", "roles", "models"],
      "properties": {
        "resolved": {
          "type": "boolean"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_executive",
            "domain_specialist",
            "sales_manager",
            "revops"
          ],
          "properties": {
            "account_executive": {
              "type": "string",
              "minLength": 1
            },
            "domain_specialist": {
              "type": "string",
              "minLength": 1
            },
            "sales_manager": {
              "type": "string",
              "minLength": 1
            },
            "revops": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_id",
              "model_digest",
              "prompt_hash",
              "provider_settings",
              "provider_defaults"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "model_digest": {
                "type": ["string", "null"],
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "prompt_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "provider_settings": {
                "type": "object"
              },
              "provider_defaults": {
                "type": "boolean",
                "description": "Whether unspecified model settings use provider defaults."
              },
              "provider_defaults_digest": {
                "type": ["string", "null"],
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "Digest of the canonical provider-default and API configuration."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "provider_defaults": {"const": true}
                  }
                },
                "then": {
                  "required": ["provider_defaults_digest"],
                  "properties": {
                    "provider_defaults_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolved": {"const": true}
            }
          },
          "then": {
            "properties": {
              "models": {
                "minProperties": 1,
                "additionalProperties": {
                  "properties": {
                    "model_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "stakeholder_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_digest", "prompt_hash", "seed"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "official_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "timeout_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls_per_checkpoint", "turns_per_checkpoint", "timeout_seconds", "retries"],
      "properties": {
        "tool_calls_per_checkpoint": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "turns_per_checkpoint": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "timeout_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Open Team launch retries or Fixed Harness activation retries."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved", "runtime_version", "image_digest", "git_revision", "executor_policy_digest"],
      "properties": {
        "resolved": {
          "type": "boolean"
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "image_digest": {
          "type": ["string", "null"],
          "description": "Immutable OCI image or package artifact digest when resolved.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "git_revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "executor_policy_digest": {
          "type": ["string", "null"],
          "description": "SHA-256 digest of effective evaluator host and job policy, including inherited rlimits.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolved": {"const": true}
            }
          },
          "then": {
            "properties": {
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "git_revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "executor_policy_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["created", "running", "completed", "failed", "invalid"]
    }
  }
}
