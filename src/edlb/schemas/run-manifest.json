{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edlb.example/schemas/v1/run-manifest.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "benchmark_version",
    "world_id",
    "track",
    "team_id",
    "protocol_version",
    "tool_schema_version",
    "scenario_hash",
    "rubric_hash",
    "oracle_hash",
    "seed",
    "agent_manifest",
    "stakeholder_manifest",
    "limits",
    "environment",
    "started_at",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "benchmark_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "track": {
      "type": "string",
      "enum": ["fixed_harness", "open_team"]
    },
    "team_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tool_schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracle_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "agent_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_executive",
            "domain_specialist",
            "sales_manager",
            "revops"
          ],
          "properties": {
            "account_executive": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "domain_specialist": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sales_manager": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "revops": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "stakeholder_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_digest", "prompt_hash", "seed"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "official_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls_per_checkpoint", "turns_per_checkpoint", "retries"],
      "properties": {
        "tool_calls_per_checkpoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "turns_per_checkpoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_version", "image_digest", "git_revision"],
      "properties": {
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "git_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["created", "running", "completed", "failed", "invalid"]
    }
  }
}
